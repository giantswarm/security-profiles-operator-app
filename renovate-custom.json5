{
  extends: [
    "github>giantswarm/renovate-presets:disable-vendir.json5",
    "github>giantswarm/renovate-presets:disable-helm-values.json5",
    "github>giantswarm/renovate-presets:disable-upstream-charts.json5",
  ],
  regexManagers: [
    {
      fileMatch: [
        "helm/security-profiles-operator/Chart\\.yaml$",
        "helm/.*/values\\.yaml$",
        "helm/.*/values\\.schema\\.json$",
        "helm/.*/README\\.md$",
      ],
      matchStrings: [
        "kubernetes-sigs/security-profiles-operator/blob/(?<currentValue>v[^/]+)/",
        "spoImage:\\s*\\n(?:[^\\n]*\\n)*?\\s*tag:\\s*(?<currentValue>v[^\\s]+)",
        "appVersion:\\s*(?<currentValue>[^\\s]+)",
      ],
      depNameTemplate: "kubernetes-sigs/security-profiles-operator",
      datasourceTemplate: "github-releases",
    },
    {
      // The default selinuxd image, which Giant Swarm points at the el9 image
      // (retagger copies it to giantswarm/selinuxd). Keeps its digest at the
      // one latest has on gsoci, which upstream pins for el9 as well.
      fileMatch: ["^helm/security-profiles-operator/values\\.yaml$"],
      matchStrings: [
        "default:\\s*\\n\\s*registry: (?<registryUrl>[^\\s]+)\\s*\\n\\s*repository: (?<depName>giantswarm/selinuxd)\\s*\\n\\s*tag: (?<currentValue>latest)\\s*\\n\\s*digest: (?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      registryUrlTemplate: "https://{{{registryUrl}}}",
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      groupName: "security-profiles-operator",
      branchPrefix: "renovate/vendir/",
      matchDepNames: ["kubernetes-sigs/security-profiles-operator"],
      prCreation: "approval",
    },
    {
      branchPrefix: "renovate/vendir/",
      matchDepNames: ["SELinuxProject/refpolicy"],
      prCreation: "approval",
    },
  ],
}
